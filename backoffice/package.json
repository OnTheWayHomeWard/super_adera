{
  "name": "adera-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adera staff dashboard (Refine + Ant Design), served at /backoffice through the gateway",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.104.1",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
