# --- Notification delivery mode (step: notification-service) ---
# SMS_PROVIDER: console (log only) | twilio (REAL SMS, costs money)
# EMAIL_PROVIDER: mailpit (local inbox) | resend (REAL email)
# Real providers need NOTIFY_DEV_ENDPOINTS=false. NOTIFY_LIVE_ALLOWLIST (comma separated) limits real sends to those recipients.
SMS_PROVIDER=console
EMAIL_PROVIDER=mailpit
NOTIFY_DEV_ENDPOINTS=true
NOTIFY_LIVE_ALLOWLIST=

