{
 "uid": "adera-overview",
 "title": "Adera overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Services up (1 = yes)",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Gateway requests per second, by status code",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 16,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code) (rate(apisix_http_status[1m]))",
     "legendFormat": "{{code}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "title": "Gateway p95 latency (ms)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "title": "Rate-limited requests (429) in the last hour",
   "type": "stat",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(apisix_http_status{code=\"429\"}[1h])) or vector(0)",
     "legendFormat": "429s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "title": "RabbitMQ messages waiting",
   "type": "stat",
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rabbitmq_queue_messages) or vector(0)",
     "legendFormat": "messages",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 6,
   "title": "Recent errors in any container",
   "type": "logs",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=~\".+\"} |~ \"(?i)(error|fatal|panic|exception)\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}