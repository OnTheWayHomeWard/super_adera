# Which environment THIS deployment is: dev or prod (default dev). One deployment = one environment; they never co-exist.
# Keys and allowed server IPs are stored for both in the dashboard, but only the matching one is active here: a partner key of
# the other environment is refused with 403 wrong_environment. Same value for registry-service and notification-service (compose does this).
ADERA_ENV=dev

POSTGRES_USER=adera_admin
POSTGRES_PASSWORD=
KRATOS_DB_PASSWORD=
USER_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
# FIREBASE_SERVICE_ACCOUNT_B64 is deliberately NOT set here: docker-compose does not pass it. For real push (FCM_PROVIDER=firebase) put it
# in Infisical (dev, folder /notification); notification-service loads it from there at startup, like the Twilio and Resend keys.
REDIS_ADMIN_PASSWORD=
RABBITMQ_ADMIN_USER=adera_admin
RABBITMQ_ADMIN_PASSWORD=
USER_SVC_RABBIT_PASSWORD=
NOTIFICATION_SVC_RABBIT_PASSWORD=
INFISICAL_DB_PASSWORD=
INFISICAL_REDIS_PASSWORD=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DOMAIN=http://localhost:8080
INFISICAL_IDENTITY_ID=
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
APISIX_REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
SMS_PROVIDER=console
EMAIL_PROVIDER=mailpit
# true = GET /dev/messages shows recent one-time codes (dev). docker-compose defaults to true when unset (the dev stack); the service itself
# defaults to false when started without compose (safe by default). Must be false in production and whenever SMS_PROVIDER/EMAIL_PROVIDER is real.
NOTIFY_DEV_ENDPOINTS=true
NOTIFY_LIVE_ALLOWLIST=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
USER_GATEWAY_SECRET=
REGISTRY_DB_PASSWORD=
INTERNAL_API_SECRET=
ALIAS_HMAC_SECRET=
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Partner platform: set true ONLY for local e2e tests (callbacks to private addresses). Never with real providers.
PARTNER_ALLOW_PRIVATE_CALLBACKS=false
FCM_PROVIDER=fake
